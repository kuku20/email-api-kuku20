@timespanfmp = historical-chart
@fmprange =1min
# 1min, 5min, 15min, 30min, 1hour, 4hour

@timespanpolygon = minute
#  second minute hour day week month quarter year
### get all data for chart form Polygon max 2 year
@ticker = QQQ
curl --location '{{rootUrl}}/stock/chartdata/{{timespanpolygon}}?stockTicker={{ticker}}&range=1&start=2024-10-24&end=2025-10-24&limit=600'

### get all data for mprange =5min
curl --location '{{rootUrl}}/stock/chartdata/{{timespanfmp}}?stockTicker=QQQ&range={{fmprange}}&start=2024-02-11&end=2025-12-12&limit=600'

### get all data daily chart form FMp max 5 year
curl --location '{{rootUrl}}/stock/daily-chart?stockTicker=TSLA&start=2024-10-23&end=2024-10-24'

