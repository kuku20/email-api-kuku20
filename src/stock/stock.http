### Getdata daily from firebase     const urlPath = `${path}/${ticker.toUpperCase()}/${date}.json`
curl --location '{{rootUrl}}/stock/getfbdata' \
--header 'Content-Type: application/json' \
--data-raw '{
    "path": "history2/1min-modifire",
    "ticker":"QQQ",
    "date":"2024-11-18"
}'
# /eyJhbGciOiJSUzI1NiIsImtpZCI6ImE2YzYzNTNm/history2/15min-modifire/QQQ/2024-10-16

### POST data daily from firebasePOST /stock/postfbdata HTTP/1.1
curl -X POST http://localhost:3000/stock/postfbdata \
  -H "Content-Type: application/json" \
  -H "User-Agent: vscode-restclient" \
  -d '{
    "path": "newNed/hihi",
    "ticker": "QQQ",
    "date": "2024-11-18",
    "data": {
      "buy": {
        "2024-11-04 09:30:00": {
          "open": 486.82,
          "low": 486.76,
          "high": 487.32,
          "close": 486.96,
          "volume": 317806,
          "MACDLine": null,
          "SignalLine": "N/A",
          "MACDHistogram": "N/A"
        }
      }
    }
  }'


